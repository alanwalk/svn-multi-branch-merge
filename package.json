    "prepack": "npm run build",
    "run:dist": "node dist/main.js"
  },
  "dependencies": {
    "@inquirer/core": "^10.3.2",
    "@inquirer/prompts": "^7.4.0",
    "chalk": "^5.3.0",
    "cli-truncate": "^6.1.1",
    "fast-xml-parser": "^5.11.1",
    "jsonc-parser": "^3.3.1",
    "log-update": "^8.0.0",
    "string-width": "^8.2.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
