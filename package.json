{
  "name": "@alanwalk/svn-multi-branch-merge",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "SVN multi-branch merge CLI tool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanwalk/svn-multi-branch-merge.git"
  },
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "svnmbm": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
